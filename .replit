modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-schema-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "vismed-feed-regression"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && node dist/main.js & cd apps/web && npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "api-schema-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && npx prisma validate --schema prisma/schema.prisma && npm run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "vismed-feed-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && npm test -- --runInBand src/bookings/booking-sync.service.vismed-feed-mode.spec.ts src/clinics/clinics.service.vismed-feed-mode.spec.ts src/bookings/booking-sync.service.vismed-rebind.spec.ts src/bookings/booking-sync.doctoralia-ingestion.spec.ts src/bookings/booking-safety-sweep.service.spec.ts src/bookings/doctoralia-poll-concurrency.spec.ts src/bookings/clinic-concurrency-guard.spec.ts src/bookings/wp04-global-slot-sync-concurrency.spec.ts src/bookings/booking-sync.service.break-dedup.spec.ts src/bookings/integration-status-gate.spec.ts src/bookings/booking-sync.empresa-guard.spec.ts src/bookings/booking-claim.service.spec.ts src/bookings/queue.vismed-timeout.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
JWT_SECRET = "vismed_jwt_secret_replit_2024"
VISMED_API_PORT = "3000"

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "cd /home/runner/workspace/apps/api && node dist/main.js & cd /home/runner/workspace/apps/web && npm run start"]
build = ["sh", "-c", "cd /home/runner/workspace/apps/api && npx tsc && npx prisma db push --accept-data-loss && npx prisma db execute --file prisma/migrations/20260809_syncjob_dedup_lease/migration.sql --schema prisma/schema.prisma && node prisma/seed.js && cd /home/runner/workspace/apps/web && npm run build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
